# Plantilla de configuracion por ambiente. Copiar a .env.<ambiente> y completar.
# NOTA: en compose el password se interpola; un '$' literal se escribe '$$'.
POSTGRES_DB=design-software-develop
POSTGRES_USER=design_software_user
POSTGRES_PASSWORD=change-me
# Puerto host por ambiente: develop=15432 qa=15433 staging=15434 main=15435
POSTGRES_PORT=15432
# Nombre de proyecto compose por ambiente: ds-develop|ds-qa|ds-staging|ds-main
# (aisla contenedor/volumen por ambiente; sin esto los 4 comparten datos)
COMPOSE_PROJECT_NAME=ds-develop
# Usuario de aplicacion (least-privilege) que usan los servicios
APP_DB_USER=design_software_app
APP_DB_PASSWORD=change-me-app
# Ruta a la carpeta con los repos -db (relativa al compose o absoluta). Default: ../../database
DB_REPOS_DIR=../../database
